{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "切向量化",
  "version": "1.5.0",
  "identifier": "com.mirac.metatorio-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "切向量化",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4OEFFQTI1RUM5QTc4RjIKUldUeWVKcnNKZXFLcUhvTzJPNUR1dlFKdCtGWERveFFJd3ZDMXpJYkwwNUozemsrdjVBVjBqQkUK",
      "endpoints": [
        "https://github.com/cyx2015s/metatorio-calc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
